# Copy to .env.local for local development.
#
# Base URL of the deployed game API. Used only by the Vite dev-server proxy
# (see vite.config.ts) so that `/api/...` resolves locally.
#
# Obtain it after deploying the Api stack:
#   aws cloudformation describe-stacks \
#     --stack-name CancercareGameMvp-Api \
#     --query 'Stacks[0].Outputs[?OutputKey==`ApiBaseUrl`].OutputValue' \
#     --output text --profile cancercare-game-mvp
VITE_API_PROXY_TARGET=
