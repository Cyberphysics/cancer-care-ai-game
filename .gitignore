# Dependencies
node_modules/

# Python (agent) — build artifacts and local environments
agents/*/.build/
agents/*/dist/
agents/*/.venv/
__pycache__/
*.pyc
.pytest_cache/


# Build outputs
dist/
build/
*.tsbuildinfo

# CDK synthesized artifacts
cdk.out/

# CDK context cache — commit it deliberately if an env lookup is ever introduced
cdk.context.json

# CodeGraph index — local code-intelligence cache, rebuilt by `codegraph init`
.codegraph/

# Environment files (never commit real values)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Local environment notes — account id, profile names. Kept on disk, not published.
local-dev-env-info.md

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets — never commit these
*.pem
*.key
*.p12
credentials
